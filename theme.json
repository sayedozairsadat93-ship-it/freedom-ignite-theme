function freedom_ignite_comment_form_defaults($args): array {
    $args['class_submit'] = 'button';
    return $args;
}
add_filter('comment_form_defaults', 'freedom_ignite_comment_form_defaults');

function freedom_ignite_body_classes($classes): array {
    $classes[] = 'theme-freedom-ignite';
    return $classes;
}
add_filter('body_class', 'freedom_ignite_body_classes');

function freedom_ignite_nav_menu_items($items, $args): string {
    if ('primary' !== $args->theme_location) {
        return $items;
    }

    return $items;
}
add_filter('wp_nav_menu_items', 'freedom_ignite_nav_menu_items', 10, 2);

function freedom_ignite_customizer($wp_customize): void {
    $wp_customize->add_section(
        'freedom_ignite_theme_options',
        array(
            'title' => __('Theme Options', 'freedom-ignite'),
            'priority' => 30,
        )
    );

    $wp_customize->add_setting('freedom_ignite_header_cta_text', array('default' => 'Get Tickets'));
    $wp_customize->add_control('freedom_ignite_header_cta_text', array(
        'label' => __('Header CTA', 'freedom-ignite'),
        'section' => 'freedom_ignite_theme_options',
        'type' => 'text',
    ));

    $wp_customize->add_setting('freedom_ignite_header_cta_url', array('default' => '#registration'));
    $wp_customize->add_control('freedom_ignite_header_cta_url', array(
        'label' => __('Header CTA URL', 'freedom-ignite'),
        'section' => 'freedom_ignite_theme_options',
        'type' => 'url',
    ));
}
add_action('customize_register', 'freedom_ignite_customizer');

function freedom_ignite_get_header_cta(): string {
    $cta_text = get_theme_mod('freedom_ignite_header_cta_text', 'Get Tickets');
    $cta_url = get_theme_mod('freedom_ignite_header_cta_url', '#registration');
    return '<a class="button" href="' . esc_url($cta_url) . '">' . esc_html($cta_text) . '</a>';
}

function freedom_ignite_get_hero_tagline(): string {
    return __('Event / Community / Cause', 'freedom-ignite');
}

function freedom_ignite_get_intro_text(): string {
    return __('We build unforgettable experiences that connect people, celebrate purpose, and inspire action.', 'freedom-ignite');
}

function freedom_ignite_excerpt($content, $max_chars = 140): string {
    $clean = wp_strip_all_tags($content);
    if (mb_strlen($clean) <= $max_chars) {
        return $clean;
    }
    return trim(mb_substr($clean, 0, $max_chars)) . '...';
}
