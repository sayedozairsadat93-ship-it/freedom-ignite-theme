<?php
if (!defined('ABSPATH')) {
    exit;
}

function freedom_ignite_setup(): void {
    add_theme_support('title-tag');
    add_theme_support('post-thumbnails');
    add_theme_support('responsive-embeds');
    add_theme_support('align-wide');
    add_theme_support('editor-styles');
    add_editor_style('style.css');
    add_theme_support(
        'html5',
        array(
            'comment-form',
            'comment-list',
            'gallery',
            'caption',
            'style',
            'script',
            'navigation-widgets',
        )
    );
    add_theme_support(
        'custom-logo',
        array(
            'height' => 80,
            'width' => 200,
            'flex-height' => true,
            'flex-width' => true,
            'unlink-homepage-logo' => false,
        )
    );

    register_nav_menus(
        array(
            'primary' => __('Primary Menu', 'freedom-ignite'),
            'footer' => __('Footer Menu', 'freedom-ignite'),
        )
    );
}
add_action('after_setup_theme', 'freedom_ignite_setup');

function freedom_ignite_enqueue_assets(): void {
    $theme_version = wp_get_theme()->get('Version');

    wp_enqueue_style('freedom-ignite-style', get_stylesheet_uri(), array(), $theme_version);
    wp_enqueue_script('freedom-ignite-theme', get_template_directory_uri() . '/assets/js/theme.js', array(), $theme_version, true);
}
add_action('wp_enqueue_scripts', 'freedom_ignite_enqueue_assets');

function freedom_ignite_handle_contact_form(): void {
    if (!isset($_POST['freedom_contact_submit'])) {
        return;
    }

    if (!wp_verify_nonce($_POST['_wpnonce'] ?? '', 'freedom_contact')) {
        wp_safe_redirect(add_query_arg('contact_error', 'nonce', home_url('/')));
        exit;
    }

    $name = sanitize_text_field(wp_unslash($_POST['name'] ?? ''));
    $email = sanitize_email(wp_unslash($_POST['email'] ?? ''));
    $phone = sanitize_text_field(wp_unslash($_POST['phone'] ?? ''));
    $organization = sanitize_text_field(wp_unslash($_POST['organization'] ?? ''));
    $interest = sanitize_text_field(wp_unslash($_POST['interest'] ?? ''));
    $message = sanitize_textarea_field(wp_unslash($_POST['message'] ?? ''));

    if (empty($name) || empty($email) || empty($message)) {
        wp_safe_redirect(add_query_arg('contact_error', 'missing', home_url('/')));
        exit;
    }

    $to = get_option('admin_email');
    $subject = sprintf(__('New event inquiry from %s', 'freedom-ignite'), $name);
    $body = "Name: $name\nEmail: $email\nPhone: $phone\nOrganization: $organization\nInquiry Type: $interest\n\nMessage:\n$message";
    $headers = array('Content-Type: text/plain; charset=UTF-8', 'Reply-To: ' . $email);

    $success = wp_mail($to, $subject, $body, $headers);

    if ($success) {
        wp_safe_redirect(add_query_arg('contact_success', '1', home_url('/')));
    } else {
        wp_safe_redirect(add_query_arg('contact_error', 'mail', home_url('/')));
    }
    exit;
}
add_action('init', 'freedom_ignite_handle_contact_form');

